# Local backend development without docker for the app itself
# (php artisan serve + php artisan queue:work). For the full stack use
# the root .env.example and `make up`.

APP_NAME="Product Import"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (e.g. the "db" service from docker compose exposed on 5432)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=products
DB_USERNAME=products
DB_PASSWORD=secret

# rabbitmq | sync (sync runs imports inside the HTTP request, handy for debugging)
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

CACHE_STORE=database
SESSION_DRIVER=array
FILESYSTEM_DISK=local

IMPORT_QUEUE=imports
IMPORT_MAX_FILE_SIZE_KB=10240
IMPORT_RATE_LIMIT_PER_MINUTE=5
IMPORT_IMAGE_TIMEOUT=15
IMPORT_IMAGE_MAX_SIZE_KB=10240
PUBLIC_STORAGE_URL=/storage

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
