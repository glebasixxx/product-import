# =====================================================================
#  Environment for docker compose (copied to .env by `make setup`)
#  Values are passed to the app/worker containers and used by compose.
# =====================================================================

# ---- Application ----------------------------------------------------
APP_NAME="Product Import"
# production | local
APP_ENV=production
# Generated by `make setup` (php artisan key:generate). Required.
APP_KEY=
APP_DEBUG=false
# Public URL of the application (nginx)
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

# Host port nginx is published on
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- Database (PostgreSQL, service "db") ----------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=products
DB_USERNAME=products
DB_PASSWORD=secret
# Host port to reach Postgres from your machine (optional)
DB_FORWARD_PORT=5432

# ---- Queue (RabbitMQ, service "rabbitmq") ---------------------------
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Default queue name; imports go to IMPORT_QUEUE
RABBITMQ_QUEUE=default
# Host port of the RabbitMQ management UI
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Cache / sessions -----------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=array

# ---- Import ---------------------------------------------------------
# Queue consumed by the "worker" service
IMPORT_QUEUE=imports
# Max upload size in KB
IMPORT_MAX_FILE_SIZE_KB=10240
# Import requests per minute per user
IMPORT_RATE_LIMIT_PER_MINUTE=5
# Image download timeout (seconds) and max size (KB)
IMPORT_IMAGE_TIMEOUT=15
IMPORT_IMAGE_MAX_SIZE_KB=10240
# Base URL of downloaded images (served by nginx from the shared volume)
PUBLIC_STORAGE_URL=/storage

# ---- Seeded administrator (login page) ------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
